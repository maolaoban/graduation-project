.common-card {
  width: 100%;
}
.common-card .news-card {
  width: 100%rpx;
  margin: 0 30rpx;
  padding: 20rpx 0;
}
.common-card .news-card .card-title {
  font-size: 32rpx;
  color: #333;
}
.common-card .news-card .card-cover_one {
  width: 100%;
  height: 300rpx;
  margin-top: 10rpx;
  border-radius: 10rpx;
  overflow: hidden;
}
.common-card .news-card .card-cover_one image {
  width: 100%;
  height: 100%;
}
.common-card .news-card .card-cover_more {
  width: 100%;
  height: 200rpx;
  margin-top: 10rpx;
  border-radius: 10rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  overflow: hidden;
}
.common-card .news-card .card-cover_more .more-img {
  width: 32%;
  height: 100%;
}
.common-card .news-card .card-cover_more .more-img image {
  width: 100%;
  height: 100%;
}
.common-card .news-card .card-info {
  height: 60rpx;
  width: 100%;
  margin-top: 10rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
}
.common-card .news-card .card-info .card-info_author {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.common-card .news-card .card-info .card-info_author .author_avatar {
  height: 50rpx;
  width: 50rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  overflow: hidden;
}
.common-card .news-card .card-info .card-info_author .author_avatar image {
  width: 100%;
  height: 100%;
}
.common-card .news-card .card-info .card-info_author .card-info_name {
  font-size: 24rpx;
  color: #bbb;
}
.common-card .news-card .card-info .card-info_record {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.common-card .news-card .card-info .card-info_record view {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  margin-right: 10rpx;
  font-size: 24rpx;
  color: #bbb;
}

