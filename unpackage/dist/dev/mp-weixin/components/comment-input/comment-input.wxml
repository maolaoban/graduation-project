<view><view class="comment-input"><view data-event-opts="{{[['tap',[['showInput',['$event']]]]]}}" class="input-box" bindtap="__e">谈谈你的看法...</view><view data-event-opts="{{[['tap',[['addThumb',['$event']]]]]}}" class="add-right" bindtap="__e"><u-icon vue-id="4f6a4770-1" name="{{!is_thumb?'thumb-up':'thumb-up-fill'}}" size="50" color="{{!is_thumb?'#bbb':'#01b9fd'}}" bind:__l="__l"></u-icon></view><view data-event-opts="{{[['tap',[['addCollect',['$event']]]]]}}" class="add-right" bindtap="__e"><u-icon vue-id="4f6a4770-2" name="{{!is_collect?'star':'star-fill'}}" size="50" color="{{!is_collect?'#bbb':'#01b9fd'}}" bind:__l="__l"></u-icon></view><view class="add-right"><u-icon vue-id="4f6a4770-3" name="zhuanfa" size="50" color="#bbb" bind:__l="__l"></u-icon></view></view><view hidden="{{!(show)}}" class="input-box_true"><textarea class="input-text" type="text" placeholder="谈谈你的看法..." confirm-type="send" maxlength="120" fixed="true" cursor-spacing="150" focus="{{isFocus}}" show-confirm-bar="{{false}}" data-event-opts="{{[['input',[['__set_model',['','inputValue','$event',[]]]]]]}}" value="{{inputValue}}" bindinput="__e"></textarea><view class="input-box_bottom"><view class="text-num">{{''+inputValue.length+'/120'}}</view><view data-event-opts="{{[['tap',[['sendComment',['$event']]]]]}}" class="send-btn" bindtap="__e">发送</view></view></view><u-mask vue-id="4f6a4770-4" show="{{show}}" z-index="10" data-event-opts="{{[['^click',[['e0']]]]}}" bind:click="__e" bind:__l="__l"></u-mask></view>