.comment-input {
  height: 100rpx;
  width: 100%;
  padding: 0 20rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1rpx solid #f4f5f6;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.comment-input .input-box {
  height: 60rpx;
  width: 500rpx;
  border-radius: 30rpx;
  background-color: #f4f5f6;
  line-height: 60rpx;
  padding-left: 20rpx;
  color: #bbb;
}
.comment-input .add-right {
  width: 80rpx;
  text-align: center;
}
.input-box_true {
  height: 250rpx;
  width: 100%;
  padding: 20rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 20;
}
.input-box_true .input-text {
  height: 150rpx;
  width: 100%;
  background-color: #f4f5f6;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.input-box_true .send-btn {
  height: 50rpx;
  width: 100rpx;
  position: absolute;
  bottom: 20rpx;
  right: 40rpx;
  border-radius: 25rpx;
  background-color: #01b9fd;
  text-align: center;
  line-height: 50rpx;
  color: #fff;
}

