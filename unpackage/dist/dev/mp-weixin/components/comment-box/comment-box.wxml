<view class="comment-container"><view class="comment-title">热门评论</view><block wx:if="{{comment.length>0}}"><view><block wx:for="{{comment}}" wx:for-item="item" wx:for-index="__i0__"><view class="comment-body"><view class="comment-body_top"><view class="comment-body_avatar"><image src="{{item.avatar}}" mode="aspectFit"></image></view><view class="comment-body_right"><view class="comment-body_info"><view class="body-info_name">{{''+item.name+''}}</view><view class="body-info_like"><u-icon vue-id="{{'1f87e446-1-'+__i0__}}" name="{{!isThumb?'thumb-up':'thumb-up-fill'}}" size="30" color="{{!isThumb?'#333':'#01b9fd'}}" bind:__l="__l"></u-icon><text>{{item.like_count}}</text></view></view><view class="comment-body_time">{{''+item.time+''}}</view></view></view><view class="comment-body_text">{{''+item.content+''}}</view></view></block></view></block><block wx:else><view class="no-comment">当前暂无评论</view></block></view>