<view class="chat-message"><block wx:if="{{message.type===0}}"><view class="other-message"><view class="chat-avatar"><image src="{{message.avatar}}" mode="aspectFill"></image></view><block wx:if="{{message.msg}}"><view class="message-box_text"><text>{{message.msg}}</text></view></block><block wx:if="{{message.img}}"><view data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" class="message-box_image" bindtap="__e"><image src="../../static/images/cool-background.png" mode="aspectFill"></image></view></block></view></block><block wx:else><view class="my-message"><block wx:if="{{message.msg}}"><view class="message-box_text"><text>{{message.msg}}</text></view></block><block wx:if="{{message.img}}"><view data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" class="message-box_image" bindtap="__e"><image src="../../static/images/cool-background.png" mode="aspectFill"></image></view></block><view class="chat-avatar"><image src="{{message.avatar}}" mode="aspectFill"></image></view></view></block></view>