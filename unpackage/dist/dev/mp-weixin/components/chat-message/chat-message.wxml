<view class="chat-message"><block wx:if="{{message.type===0}}"><view class="other-message"><view class="chat-avatar"><image src="{{message.avatar}}" mode="aspectFill"></image></view><block wx:if="{{message.msg}}"><view class="message-box_text"><rich-text nodes="{{message.msg}}"></rich-text></view></block><block wx:if="{{message.audio}}"><view data-event-opts="{{[['tap',[['playAudio',['$0'],['message.audio']]]]]}}" class="message-box_audio" bindtap="__e"><view class="iconfont icon-voiceprint _i"></view><view class="iconfont icon-voiceprint _i"></view></view></block><block wx:if="{{message.imgUrl}}"><view data-event-opts="{{[['tap',[['previewImage',['$0'],['message.imgUrl']]]]]}}" class="message-box_image" bindtap="__e"><image src="{{message.imgUrl}}" mode="widthFix"></image></view></block></view></block><block wx:else><view class="my-message"><block wx:if="{{message.msg}}"><view class="message-box_text"><rich-text nodes="{{message.msg}}"></rich-text></view></block><block wx:if="{{message.audio}}"><view data-event-opts="{{[['tap',[['playAudio',['$0'],['message.audio.tempFilePath']]]]]}}" class="message-box_audio" bindtap="__e"><block wx:for="{{$root.g0>6?6:$root.g1}}" wx:for-item="item" wx:for-index="__i0__"><view class="iconfont icon-voiceprint _i"></view></block><text>{{$root.g2+"s"}}</text></view></block><block wx:if="{{message.imgUrl}}"><view data-event-opts="{{[['tap',[['previewImage',['$0'],['message.imgUrl']]]]]}}" class="message-box_image" bindtap="__e"><image src="{{message.imgUrl}}" mode="widthFix"></image></view></block><view class="chat-avatar"><image src="{{message.avatar}}" mode="aspectFill"></image></view></view></block></view>