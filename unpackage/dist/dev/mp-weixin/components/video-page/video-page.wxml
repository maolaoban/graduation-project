<view class="video-card"><view class="video-card_body"><block wx:for="{{videoList}}" wx:for-item="item" wx:for-index="__i0__" wx:key="_id"><view data-event-opts="{{[['tap',[['playVideo',['$event']]]]]}}" class="video-card_box" bindtap="__e"><view class="video-cover"><image src="{{item.top_cover}}" mode="aspectFill"></image><view class="video-info"><view class="video-info_left"><u-icon vue-id="{{'ecb73f3c-1-'+__i0__}}" name="play-right" color="#fff" size="20" bind:__l="__l"></u-icon><text>{{item.view_count}}</text></view><view class="video-info_right">{{''+item.duration+''}}</view></view></view><view class="video-footer"><view class="video-title">{{''+item.title+''}}</view><view class="video-author">{{''+item.author_name+''}}</view></view></view></block></view></view>