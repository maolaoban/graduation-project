.popup {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.1);
}
.popup .popup-box {
  width: 600rpx;
  height: 400rpx;
  position: fixed;
  margin: 0 75rpx;
  top: 50%;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0px 8rpx 20rpx 0px #CCCCCC;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.popup .popup-box .close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}
.popup .popup-box .sign-emoji {
  width: 500rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-wrap: wrap;
          flex-wrap: wrap;
  margin-top: 60rpx;
}
.popup .popup-box .sign-emoji view {
  width: 80rpx;
  height: 80rpx;
  font-size: 60rpx;
  margin: 10rpx;
}
.popup .popup-box .sign-success {
  margin-top: 60rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.popup .popup-box .sign-success .emoji {
  font-size: 100rpx;
}
.popup .popup-box .sign-success .text {
  margin-top: 20rpx;
  font-size: 32rpx;
}
.popup .popup-box .popup-button {
  width: 240rpx;
  height: 60rpx;
  position: absolute;
  bottom: 40rpx;
  background-color: #f7e410;
  border-radius: 40rpx;
  color: #333;
  font-size: 30rpx;
  text-align: center;
  line-height: 60rpx;
}

