<view class="detail-container"><view class="top-bar"><view style="{{'height:'+(statusBarHeight+'px')+';'+('background-color:'+('#fff')+';')}}"></view><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="back-btn" style="{{'height:'+(topBarHeight+2+'px')+';'}}" bindtap="__e"><u-icon vue-id="5b388cb0-1" name="arrow-leftward" color="#7e7e7e" size="40" bind:__l="__l"></u-icon><text style="{{'width:'+(menuButtonLeft-60+'px')+';'}}">{{contentInfo.title}}</text></view></view><view style="{{'height:'+(topBarHeight+2+statusBarHeight+'px')+';'}}"></view><view class="top-box"><video src="https://static.mobage.cn/html/promotion/game/12000128/autumn/index/op2_yy.mp4" page-gesture="true" title="{{videoTitle}}" object-fit="cover" controls="{{true}}"></video></view><view class="author-info"><view class="info-left"><view class="author-avatar"><image src="../../static/logo.png" mode="aspectFill"></image></view><view class="author-name"><text class="name">{{contentInfo.author}}</text><text class="bio">这家伙很懒，一句话都竟然没留下，真奇怪。</text></view></view><view data-event-opts="{{[['tap',[['addFollow',['$event']]]]]}}" class="{{['author-follow',(isFollow)?'followed':'']}}" bindtap="__e">{{''+(isFollow?'已关注':'关注')+''}}</view></view><view class="detail-content"><view class="content-title">{{''+contentInfo.title+''}}</view><view class="content-time"><text>{{contentInfo.create_time}}</text><text>{{"阅读 "+contentInfo.read_count}}</text></view><view class="u-content"><u-parse vue-id="5b388cb0-2" html="{{contentInfo.content}}" bind:__l="__l"></u-parse></view></view><comment-box vue-id="5b388cb0-3" bind:__l="__l"></comment-box></view>