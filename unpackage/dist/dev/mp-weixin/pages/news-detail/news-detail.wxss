.top-bar {
  z-index: 20;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
}
.back-btn {
  width: 100%;
  height: 80rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  background-color: #fff;
  padding: 0 20rpx;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  z-index: 10;
}
.back-btn text {
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  margin-left: 20rpx;
}
.top-box {
  width: 100%;
  height: 400rpx;
}
.top-box image {
  width: 100%;
  height: 100%;
}
.top-box video {
  z-index: 15;
  width: 100%;
  height: 100%;
}
.author-info {
  width: 100%;
  height: 120rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  padding: 0 30rpx;
}
.author-info .info-left {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.author-info .info-left .author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}
.author-info .info-left .author-avatar image {
  width: 100%;
  height: 100%;
}
.author-info .info-left .author-name {
  margin-left: 20rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
}
.author-info .info-left .author-name .name {
  font-size: 30rpx;
  color: #333;
}
.author-info .info-left .author-name .bio {
  font-size: 24rpx;
  color: rgba(51, 51, 51, 0.6);
}
.author-info .author-follow {
  height: 50rpx;
  width: 100rpx;
  border-radius: 10rpx;
  background-color: #01b9fd;
  text-align: center;
  line-height: 50rpx;
  font-size: 26rpx;
  color: #fff;
}
.author-info .followed {
  background-color: #bbb;
}
.detail-content {
  padding: 20rpx;
}
.detail-content .content-title {
  font-size: 44rpx;
  color: #333;
  font-weight: 700;
}
.detail-content .content-time {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #bbb;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: end;
  -webkit-justify-content: flex-end;
          justify-content: flex-end;
}
.detail-content .content-time text {
  margin-left: 20rpx;
}
.detail-content .u-content {
  margin-top: 20rpx;
  font-size: 32rpx;
}

