  background-color: #ececec;
}
.message-content {
  width: 100%;
  padding: 30rpx;
}
.message-content .message-content_header {
  font-size: 28rpx;
  color: #333;
}
.message-content .message-content_body {
  height: 150rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  border-bottom: 2rpx solid #ececec;
}
.message-content .message-content_body .message-content_li {
  height: 120rpx;
  width: 100%;
