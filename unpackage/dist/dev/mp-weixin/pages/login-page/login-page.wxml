<view class="content"><view class="content-logo"></view><block wx:if="{{!isRegister}}"><view class="content-box"><view class="input-row"><input class="m-input" type="number" placeholder="请输入手机号" placeholder-style="color:#bbb" data-event-opts="{{[['input',[['__set_model',['','username','$event',[]]]]]]}}" value="{{username}}" bindinput="__e"/></view><block wx:if="{{isPasswordLogin}}"><view class="input-row"><input class="m-input" password="{{!isShowPassword[0]}}" placeholder="请输入密码" placeholder-style="color:#bbb" data-event-opts="{{[['input',[['__set_model',['','password','$event',[]]]]]]}}" value="{{password}}" bindinput="__e"/><u-icon vue-id="16684460-1" name="{{!isShowPassword[0]?'eye-off':'eye-fill'}}" size="40" color="#bbb" data-event-opts="{{[['^click',[['showPassword',[0]]]]]}}" bind:click="__e" bind:__l="__l"></u-icon></view></block><block wx:else><view class="input-row"><input class="m-input" type="text" placeholder="请输入验证码" placeholder-style="color:#bbb" data-event-opts="{{[['input',[['__set_model',['','smsCode','$event',[]]]]]]}}" value="{{smsCode}}" bindinput="__e"/><u-line class="u-line" vue-id="16684460-2" direction="col" length="40rpx" color="#bbb" bind:__l="__l"></u-line><view data-event-opts="{{[['tap',[['sendCode',['login']]]]]}}" class="send-code-btn" bindtap="__e">{{canSend?'获取验证码':sendCodeText+'s后重新发送'}}</view></view></block><view class="btn-row"><block wx:if="{{!isPasswordLogin}}"><button class="primary" type="primary" data-event-opts="{{[['tap',[['loginBySms',['$event']]]]]}}" bindtap="__e">登录</button></block><block wx:else><button class="primary" type="primary" data-event-opts="{{[['tap',[['loginByPwd',['$event']]]]]}}" bindtap="__e">登录</button></block></view><view class="btn-options"><text data-event-opts="{{[['tap',[['showRegister',['$event']]]]]}}" bindtap="__e">注册</text><text data-event-opts="{{[['tap',[['showPasswordLogin',['$event']]]]]}}" bindtap="__e">{{isPasswordLogin?'验证码登录':'密码登录'}}</text></view></view></block><block wx:else><view class="content-box"><view class="input-row"><input type="text" placeholder="请输入手机号" placeholder-style="color:#bbb" data-event-opts="{{[['input',[['__set_model',['','regUsername','$event',[]]]]]]}}" value="{{regUsername}}" bindinput="__e"/></view><view class="input-row"><input class="m-input" password="{{!isShowPassword[1]}}" placeholder="请输入密码" placeholder-style="color:#bbb" data-event-opts="{{[['input',[['__set_model',['','regPassword','$event',[]]]]]]}}" value="{{regPassword}}" bindinput="__e"/><u-icon vue-id="16684460-3" name="{{!isShowPassword[1]?'eye-off':'eye-fill'}}" size="40" color="#bbb" data-event-opts="{{[['^click',[['showPassword',[1]]]]]}}" bind:click="__e" bind:__l="__l"></u-icon></view><view class="input-row"><input class="m-input" password="{{!isShowPassword[2]}}" placeholder="请再次输入密码" placeholder-style="color:#bbb" data-event-opts="{{[['input',[['__set_model',['','confirmPassword','$event',[]]]]]]}}" value="{{confirmPassword}}" bindinput="__e"/><u-icon vue-id="16684460-4" name="{{!isShowPassword[2]?'eye-off':'eye-fill'}}" size="40" color="#bbb" data-event-opts="{{[['^click',[['showPassword',[2]]]]]}}" bind:click="__e" bind:__l="__l"></u-icon></view><view class="btn-row"><button class="primary" type="primary" data-event-opts="{{[['tap',[['register',['$event']]]]]}}" bindtap="__e">注册</button></view><view class="btn-options"><text data-event-opts="{{[['tap',[['showRegister',['$event']]]]]}}" bindtap="__e">登录</text></view></view></block></view>