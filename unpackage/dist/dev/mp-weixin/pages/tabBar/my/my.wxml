<view class="my-info"><view data-event-opts="{{[['tap',[['changeImg',['$event']]]]]}}" class="top-box" bindtap="__e"><view class="top-img"><image src="{{backImage||userInfo.backImage}}" mode="aspectFill"></image></view></view><block wx:if="{{isShow}}"><view class="user-info_box"><view class="user-avatar"><image src="{{userInfo.avatar}}" mode="aspectFill"></image></view><view class="use-info_detail"><view class="user-info"><view class="user-info_name"><view class="user-info-level">{{'LV'+userInfo.grade+''}}</view>{{''+userInfo.name+''}}</view><view data-event-opts="{{[['tap',[['editProfile',['$event']]]]]}}" class="user-edit" bindtap="__e">编辑资料</view></view><view class="user-info_num"><view class="num-text"><text>{{userInfo.publish}}</text>动态</view><view class="num-text"><text>{{userInfo.follow}}</text>关注</view><view class="num-text"><text>{{userInfo.fans}}</text>粉丝</view></view><view class="user-info_bio">{{''+userInfo.bios+''}}</view></view></view></block><block wx:else><view class="user-info_loading"><view class="user-avatar_loading"></view><view class="use-info_detail"><view class="user-info"><view class="user-info_name"><view class="user-info-level"></view><view class="user-name"></view></view></view><view class="user-info_num"></view><view class="user-info_bio"></view></view></view></block><view class="my-box"><view class="my-box_top"><view class="my-collect"><u-icon vue-id="3320c60f-1" name="heart-fill" color="pink" size="60" bind:__l="__l"></u-icon><text>我的喜欢</text></view><view class="my-collect"><u-icon vue-id="3320c60f-2" name="clock-fill" color="#876db5" size="60" bind:__l="__l"></u-icon><text>历史记录</text></view><view class="my-collect"><u-icon vue-id="3320c60f-3" name="bag-fill" color="#f8784e" size="60" bind:__l="__l"></u-icon><text>已购</text></view><view class="my-collect"><u-icon vue-id="3320c60f-4" name="chat-fill" color="#3e92b5" size="60" bind:__l="__l"></u-icon><text>我的评论</text></view></view></view><view class="create-box"><view class="create-box_top"><view class="top-left">创作数据</view><view class="top-right">我的发表></view></view><view class="create-box_content"><view class="create-count"><text>120W</text>累计阅读数</view><view class="create-count"><text>50W</text>累计评论数</view><view class="create-count"><text>100W</text>累计点赞数</view><view class="create-count"><text>65</text>人气排行</view></view></view><view class="other-option"><view data-event-opts="{{[['tap',[['goPersonalCenter',['$event']]]]]}}" class="option-list" bindtap="__e"><u-icon vue-id="3320c60f-5" name="plus-people-fill" color="#2f63b5" size="60" bind:__l="__l"></u-icon><text>个人中心</text></view><view class="option-list"><u-icon vue-id="3320c60f-6" name="lock-opened-fill" color="#52b55e" size="60" bind:__l="__l"></u-icon><text>账号安全</text></view><view data-event-opts="{{[['tap',[['goFeedBack',['$event']]]]]}}" class="option-list" bindtap="__e"><u-icon vue-id="3320c60f-7" name="server-fill" color="#ff557f" size="60" bind:__l="__l"></u-icon><text>意见反馈</text></view></view><view class="out-login">退出登录</view></view>