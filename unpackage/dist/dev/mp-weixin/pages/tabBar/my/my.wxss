page {
  background-color: #171a23;
}
.top-box {
  width: 100%;
  height: 500rpx;
  position: relative;
}
.top-box .top-img {
  width: 100%;
  height: 100%;
}
.top-box .top-img image {
  width: 100%;
  height: 100%;
}
.top-box .top-box_data {
  width: 100%;
  height: 150rpx;
  position: absolute;
  bottom: 0;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-justify-content: space-around;
          justify-content: space-around;
}
.top-box .top-box_data .box-good, .top-box .top-box_data .box-funs, .top-box .top-box_data .box-follow {
  width: 100rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  color: #fff;
}
.top-box .top-box_data .box-good .box-num, .top-box .top-box_data .box-funs .box-num, .top-box .top-box_data .box-follow .box-num {
  font-size: 40rpx;
}
.top-box .top-box_data .box-good .box-info, .top-box .top-box_data .box-funs .box-info, .top-box .top-box_data .box-follow .box-info {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}
.user-info_box {
  width: 100%;
  height: 150rpx;
  padding: 0 30rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  position: relative;
}
.user-info_box .user-avatar {
  width: 100rpx;
  height: 100rpx;
  -webkit-flex-shrink: 0;
          flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
}
.user-info_box .user-avatar image {
  width: 100%;
  height: 100%;
}
.user-info_box .user-info {
  height: 100rpx;
  width: 100%;
  overflow: hidden;
  margin-left: 20rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  color: #fff;
}
.user-info_box .user-info .user-info_name {
  height: 40rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.user-info_box .user-info .user-info_name .user-info-level {
  width: 60rpx;
  height: 30rpx;
  margin-right: 10rpx;
  background-color: #e74c3c;
  font-size: 24rpx;
  text-align: center;
  line-height: 30rpx;
  border-radius: 10rpx;
}
.user-info_box .user-info .user-info_bio {
  white-space: pre-wrap;
  color: rgba(255, 255, 255, 0.8);
}
.user-info_box .user-edit {
  border: 1px solid white;
  border-radius: 20rpx;
  position: absolute;
  padding: 0 10rpx;
  color: #fff;
  font-size: 24rpx;
  top: 30rpx;
  right: 30rpx;
}

