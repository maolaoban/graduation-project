<view class="profile-container"><view data-event-opts="{{[['tap',[['changeAvatar',['$event']]]]]}}" class="avatar-box" bindtap="__e"><view class="item-title">头像</view><view class="avatar"><image src="{{userInfo.avatar&&!isChange?userInfo.avatar:avatarSrc}}" mode="aspectFill"></image></view><view class="arrow"><u-icon vue-id="94d7176a-1" name="arrow-right" color="#e3e3e3" size="40" bind:__l="__l"></u-icon></view></view><view class="item-box"><view class="item-title">昵称</view><input class="item-content" type="text" maxlength="8" data-event-opts="{{[['input',[['__set_model',['','nickName','$event',[]]]]]]}}" value="{{nickName}}" bindinput="__e"/><view class="arrow"><u-icon vue-id="94d7176a-2" name="arrow-right" color="#e3e3e3" size="40" bind:__l="__l"></u-icon></view></view><view class="item-box"><view class="item-title">签名</view><input class="item-content" type="text" placeholder="这个人很懒，什么都没留下..." maxlength="20" data-event-opts="{{[['input',[['__set_model',['','bios','$event',[]]]]]]}}" value="{{bios}}" bindinput="__e"/><view class="arrow"><u-icon vue-id="94d7176a-3" name="arrow-right" color="#e3e3e3" size="40" bind:__l="__l"></u-icon></view></view><view class="item-box"><view class="item-title">修改密码</view><view class="item-content"></view><view class="arrow"><u-icon vue-id="94d7176a-4" name="arrow-right" color="#e3e3e3" size="40" bind:__l="__l"></u-icon></view></view><view data-event-opts="{{[['tap',[['saveInfo',['$event']]]]]}}" class="save-btn" bindtap="__e">保存</view></view>