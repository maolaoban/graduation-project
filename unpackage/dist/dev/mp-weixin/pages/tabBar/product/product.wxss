page {
  background-color: #f4f5f6;
  overflow: hidden;
}
.product-body {
  position: absolute;
  right: 0;
  left: 0;
  bottom: 0;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.classify-left {
  height: 100%;
  width: 200rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.classify-left .classify-top {
  height: 80rpx;
  width: 100%;
  text-align: center;
  line-height: 80rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #f4f5f6;
  background-color: #fff;
}
.classify-left .left-box {
  width: 100%;
  height: 100%;
}
.classify-left .left-box .scroll-item {
  height: 100rpx;
  width: 100%;
  text-align: center;
  line-height: 100rpx;
  box-sizing: border-box;
  color: #7e7e7e;
}
.classify-left .left-box .active {
  background-color: #fff;
  color: #13227A;
  font-weight: bold;
  position: relative;
}
.classify-left .left-box .active:before {
  content: '';
  width: 8rpx;
  height: 50rpx;
  background-color: #13227A;
  position: absolute;
  left: 0;
  top: 25rpx;
}
.classify-right {
  width: 550rpx;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #fff;
}
.classify-right .scroll-right {
  height: 100%;
  width: 100%;
}
.classify-right .scroll-right .right-item {
  width: 100%;
  padding: 20rpx;
}
.classify-right .scroll-right .right-item .item-title {
  color: #333;
  font-weight: bold;
  font-size: 32rpx;
}
.classify-right .scroll-right .right-item .item-list {
  width: 100%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-wrap: wrap;
          flex-wrap: wrap;
  -webkit-justify-content: space-around;
          justify-content: space-around;
}
.classify-right .scroll-right .right-item .item-list .item-list_box {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.classify-right .scroll-right .right-item .item-list .item-list_box .cover {
  width: 120rpx;
  height: 120rpx;
}
.classify-right .scroll-right .right-item .item-list .item-list_box .cover image {
  width: 100%;
  height: 100%;
}

