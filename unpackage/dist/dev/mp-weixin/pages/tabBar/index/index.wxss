page {
  height: 100%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.content {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  overflow: hidden;
}
.home-list {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  box-sizing: border-box;
}
.swiper {
  width: 100%;
}
.swiper_loading {
  width: 100%;
  height: 300rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
}
.swiper_loading .swiper {
  width: 90%;
  height: 100%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.content-middle {
  width: 100%;
  height: 150rpx;
  margin-top: 15rpx;
  padding: 15rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-justify-content: space-around;
          justify-content: space-around;
}
.content-middle .content-middle-common {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  color: #fff;
  font-size: 28rpx;
  width: 30%;
  height: 100rpx;
  border-radius: 30rpx;
}
.content-middle .content-middle-common text {
  margin-left: 6rpx;
}
.content-middle .content-middle_store {
  background-color: #4158D0;
  background-image: -webkit-linear-gradient(47deg, #4158D0 0%, #C850C0 46%, #FFCC70 100%);
  background-image: linear-gradient(43deg, #4158D0 0%, #C850C0 46%, #FFCC70 100%);
}
.content-middle .content-middle_activity {
  background-color: #08AEEA;
  background-image: -webkit-linear-gradient(28deg, #08AEEA 0%, #2AF598 100%);
  background-image: linear-gradient(62deg, #08AEEA 0%, #2AF598 100%);
}
.content-middle .content-middle_sign {
  background-color: #FF3CAC;
  background-image: -webkit-linear-gradient(225deg, #FF3CAC 0%, #784BA0 50%, #2B86C5 100%);
  background-image: linear-gradient(225deg, #FF3CAC 0%, #784BA0 50%, #2B86C5 100%);
}
.content-middle .content-middle_change {
  width: 28%;
  height: 95rpx;
}
.toutiao {
  width: 100%;
  padding: 20rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.toutiao .toutiao-container {
  width: 100%;
  height: 100%;
  border-radius: 15rpx;
  padding: 15rpx;
}
.toutiao .toutiao-container .toutiao-header {
  width: 100%;
  height: 60rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.toutiao .toutiao-container .toutiao-header .toutiao-icon {
  height: 60rpx;
  width: 60rpx;
  overflow: hidden;
  margin-right: 10rpx;
}
.toutiao .toutiao-container .toutiao-header .toutiao-icon image {
  width: 100%;
  height: 100%;
}
.toutiao .toutiao-container .toutiao-header text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.toutiao .toutiao-container .toutiao-body .body-line {
  height: 70rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.toutiao .toutiao-container .toutiao-body .body-line .body-icon {
  width: 15rpx;
  height: 15rpx;
  background-color: #f85049;
  -webkit-flex-shrink: 0;
          flex-shrink: 0;
}
.toutiao .toutiao-container .toutiao-body .body-line text {
  margin-left: 10rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
