.class-info {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  margin-top: 32rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  position: relative;
}
.class-info .class-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.class-info .class-avatar image {
  width: 100%;
  height: 100%;
}
.class-info .class-name {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  margin-left: 32rpx;
}
.class-info .class-name .name-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 400;
  line-height: 24rpx;
}
.class-info .publish-btn {
  width: 128rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background-color: #BFBFBF;
  color: #FFFFFF;
  font-weight: 400;
  font-size: 28rpx;
  text-align: center;
  line-height: 52rpx;
  letter-spacing: 4rpx;
  position: absolute;
  right: 28rpx;
  top: 0;
}
.publish-content {
  margin: 30rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-bottom: 1px #E9E9E9 solid;
}
.publish-content .publish-text {
  font-size: 28rpx;
  width: 100%;
  height: 270rpx;
  caret-color: #01b9fd;
}
.publish-image-box {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-wrap: wrap;
          flex-wrap: wrap;
  padding: 20rpx;
  margin-bottom: 160rpx;
  width: 60%;
}
.publish-image-box .publish-image-item {
  position: relative;
  width: 50%;
  height: 0;
  padding-top: 50%;
  box-sizing: border-box;
}
.publish-image-box .publish-image-item .close-icon {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 10;
}
.publish-image-box .publish-image-item .close-icon image {
  width: 100%;
  height: 100%;
}
.publish-image-box .publish-image-item .image-box {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  right: 10rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  overflow: hidden;
}
.publish-image-box .publish-image-item .image-box image {
  width: 100%;
  height: 100%;
}

