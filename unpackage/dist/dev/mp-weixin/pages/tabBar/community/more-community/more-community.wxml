<view class="community-list"><block wx:for="{{topicList}}" wx:for-item="item" wx:for-index="index" wx:key="id"><view class="topic-box"><view class="topic-box_img"><image src="{{item.cover}}" mode="aspectFill"></image><view class="topic-tag"><image src="../../../../static/images/tag.png" mode="aspectFit"></image>{{'#'+item.name+'#'}}</view></view><view class="top-box_title">{{''+item.description+''}}</view><view class="top-box_option"><view data-event-opts="{{[['tap',[['followTopic',[index]]]]]}}" class="follow-btn" bindtap="__e"><block wx:if="{{!item.isFollow}}"><view class="iconfont icon-plus _i"></view></block><block wx:else><view class="iconfont icon-icon _i"></view></block>{{''+(item.isFollow?'已关注话题':'关注话题')+''}}</view><view class="line"></view><view class="ask-btn"><view class="iconfont icon-message _i"></view>我有话说</view></view></view></block></view>