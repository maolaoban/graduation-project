.community-follow {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  -webkit-box-align: end;
  -webkit-align-items: flex-end;
          align-items: flex-end;
  padding: 10rpx 20rpx;
}
.my-follow {
  width: 80%;
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
}
.my-follow .my-follow_title {
  font-size: 32rpx;
  font-weight: bold;
}
.my-follow .follow-box_list {
  width: 100%;
  height: 100rpx;
  margin-top: 20rpx;
}
.my-follow .follow-box_list .follow-box {
  width: 100%;
  height: 100%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.my-follow .follow-box_list .follow-box .box-li {
  width: 100rpx;
  height: 100rpx;
  -webkit-flex-shrink: 0;
          flex-shrink: 0;
  margin-right: 20rpx;
}
.my-follow .follow-box_list .follow-box .box-li image {
  width: 100%;
  height: 100%;
}
.all-community {
  width: 90rpx;
  height: 90rpx;
  -webkit-flex-shrink: 0;
          flex-shrink: 0;
  border: 4rpx dotted #d1d1d1;
  margin-left: 10rpx;
  margin-bottom: 5rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
}
.community-info_box {
  width: 100%;
  margin-top: 30rpx;
  border-top: 1rpx solid #e8e8e8;
}
.community-info_box .top-post {
  height: 100rpx;
  margin: 0 20rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  border-bottom: 1rpx solid #e8e8e8;
}
.community-info_box .top-post .post-icon {
  width: 50rpx;
  height: 30rpx;
  text-align: center;
  color: #fff;
  border-radius: 10rpx;
  background-color: #01b9fd;
  font-size: 20rpx;
}
.community-info_box .top-post .post-title {
  color: #333;
  font-size: 28rpx;
  margin-left: 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

