page {
  background-color: #f3f4f5;
}
.sign-top {
  width: 100%;
  height: 300rpx;
  background-image: -webkit-linear-gradient(28deg, #08AEEA 0%, #a555f5 100%);
  background-image: linear-gradient(62deg, #08AEEA 0%, #a555f5 100%);
  -webkit-clip-path: ellipse(90% 60% at 50% 45%);
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  padding: 20rpx;
}
.sign-top .sign-top_box {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.sign-top .sign-top_box .sign-avatar {
  width: 120rpx;
  height: 120rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  overflow: hidden;
  margin-top: 20rpx;
}
.sign-top .sign-top_box .sign-avatar image {
  width: 100%;
  height: 100%;
}
.sign-top .sign-top_box .sign-info {
  width: 590rpx;
  height: 100rpx;
  padding: 10rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  margin-top: 20rpx;
}
.sign-top .sign-top_box .sign-info .sign-left {
  color: #fff;
  font-size: 36rpx;
}
.sign-top .sign-top_box .sign-info .sign-left .progress-bar {
  height: 6rpx !important;
  width: 400rpx;
}
.sign-top .sign-top_box .sign-info .sign-right {
  height: 60rpx;
  width: 150rpx;
  border-radius: 40rpx;
  border: 1px solid #f3f4f5;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}
.sign-top .sign-top_box .sign-info .sign-right image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}
.green-task, .daily-task {
  width: 710rpx;
  margin: 0 20rpx;
  background-color: #fff;
  border-radius: 40rpx;
  position: relative;
  top: -100rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
}
.green-task .task-title, .daily-task .task-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.green-task .task-list, .daily-task .task-list {
  margin-top: 20rpx;
}
.green-task .task-list .task-item, .daily-task .task-list .task-item {
  height: 100rpx;
  padding: 0 20rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
}
.green-task .task-list .task-item .task-introduce, .daily-task .task-list .task-item .task-introduce {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
}
.green-task .task-list .task-item .task-introduce text, .daily-task .task-list .task-item .task-introduce text {
  color: #333;
  font-size: 28rpx;
}
.green-task .task-list .task-item .task-introduce text:nth-child(2), .daily-task .task-list .task-item .task-introduce text:nth-child(2) {
  font-size: 24rpx;
  line-height: 40rpx;
  color: #bbb;
}
.green-task .task-list .task-item .task-action, .daily-task .task-list .task-item .task-action {
  height: 50rpx;
  padding: 0 20rpx;
  background-color: #ffff00;
  color: #333;
  border-radius: 30rpx;
  line-height: 50rpx;
  font-size: 26rpx;
}

