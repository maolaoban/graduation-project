.search-history {
  width: 100%;
  padding: 20rpx 40rpx;
}
.search-history .history-top {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.search-history .history-top .history-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #151515;
}
.search-history .history-list {
  width: 100%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-wrap: wrap;
          flex-wrap: wrap;
}
.search-history .history-list .history-item {
  -webkit-flex-shrink: 0;
          flex-shrink: 0;
  padding: 4px 10rpx;
  border-radius: 20rpx;
  border: 1rpx solid #bebebe;
  margin-right: 20rpx;
  margin-top: 20rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.search-history .history-list .history-item text {
  margin-right: 10rpx;
}
.hot-box {
  width: 100%;
  padding: 40rpx;
}
.hot-box .hot-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #151515;
}
.hot-box .hot-content {
  margin-top: 30rpx;
}
.hot-box .hot-content .hot-content_info {
  height: 80rpx;
  color: #151515;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hot-box .hot-loading {
  margin-top: 30rpx;
}
.hot-box .hot-loading .hot-loading_1 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 50%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.hot-box .hot-loading .hot-loading_2 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 80%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.hot-box .hot-loading .hot-loading_3 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 90%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.hot-box .hot-loading .hot-loading_4 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 70%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.hot-box .hot-loading .hot-loading_5 {
