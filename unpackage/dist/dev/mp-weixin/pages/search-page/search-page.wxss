.hot-box {
  width: 100%;
  padding: 40rpx;
}
.hot-box .hot-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #151515;
}
.hot-box .hot-content {
  margin-top: 30rpx;
}
.hot-box .hot-content .hot-content_info {
  height: 80rpx;
  color: #151515;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hot-box .hot-loading {
  margin-top: 30rpx;
}
.hot-box .hot-loading .hot-loading_1 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 50%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.hot-box .hot-loading .hot-loading_2 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 80%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.hot-box .hot-loading .hot-loading_3 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 90%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.hot-box .hot-loading .hot-loading_4 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 70%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}
.hot-box .hot-loading .hot-loading_5 {
  height: 30rpx;
  margin-top: 40rpx;
  width: 80%;
  border-radius: 20rpx;
  background-color: #f4f5f6;
}

