<view><navbar vue-id="5c312456-1" isSearch="{{true}}" bind:__l="__l"></navbar><view hidden="{{!(searchHistory.length>0)}}" class="search-history"><view class="history-top"><text class="history-title">搜索历史</text><u-icon vue-id="5c312456-2" name="trash" color="#7e7e7e" size="30" data-event-opts="{{[['^click',[['clearHistory']]]]}}" bind:click="__e" bind:__l="__l"></u-icon></view><view class="history-list"><block wx:for="{{searchHistory}}" wx:for-item="item" wx:for-index="index"><view class="history-item"><text>{{item}}</text><u-icon vue-id="{{'5c312456-3-'+index}}" name="close" color="#7e7e7e" size="20" data-event-opts="{{[['^click',[['delHistory',[index]]]]]}}" bind:click="__e" bind:__l="__l"></u-icon></view></block></view></view><view class="hot-box"><text class="hot-title">热门</text><block wx:if="{{!isLoading}}"><view class="hot-content"><block wx:for="{{hotList}}" wx:for-item="item" wx:for-index="index"><view class="hot-content_info"><text style="{{'color:'+(index<3?'#e74c3c':'#151515')+';'}}">{{index+1+'. '}}</text>{{''+item.title+''}}</view></block></view></block><block wx:else><view class="hot-loading"><view class="hot-loading_1"></view><view class="hot-loading_2"></view><view class="hot-loading_3"></view><view class="hot-loading_4"></view><view class="hot-loading_5"></view></view></block></view></view>