<view class="edit-container"><view class="article-info"><view class="article-title"><text class="title-text">文章标题</text><input class="title-input" type="text" value="{{articleTitle}}" placeholder="我是标题..." maxlength="50" data-event-opts="{{[['input',[['__set_model',['','articleTitle','$event',[]]]]]]}}" bindinput="__e"/></view><view class="article-cover"><text class="title-text">封面图</text><view data-event-opts="{{[['tap',[['selectCover',['$event']]]]]}}" class="select-cover" bindtap="__e"><block wx:if="{{!imgCover}}"><u-icon vue-id="54222a40-1" name="plus" size="60" color="#fff" bind:__l="__l"></u-icon></block><block wx:else><image src="{{imgCover}}" mode="scaleToFill"></image></block><block wx:if="{{!!imgCover}}"><view class="tip">修改封面</view></block></view></view><view class="article-classify"><text class="title-text">选择分类</text><view data-event-opts="{{[['tap',[['showClassify',['$event']]]]]}}" class="select-classify" bindtap="__e"><input class="select-input" type="text" placeholder="--分类--" disabled="true" value="{{classify}}"/></view></view><view class="article-tag"><text class="title-text">关键词</text><input class="tag-input" type="text" value="{{keyWords}}" placeholder="输入关键词,让更多人发现你的文章..." maxlength="15" data-event-opts="{{[['input',[['__set_model',['','keyWords','$event',[]]]]]]}}" bindinput="__e"/></view></view><jin-edit vue-id="54222a40-2" placeholder="{{placeholder}}" data-event-opts="{{[['^editOk',[['finshedEdit']]]]}}" bind:editOk="__e" bind:__l="__l"></jin-edit><u-select vue-id="54222a40-3" list="{{list}}" value="{{isShow}}" data-event-opts="{{[['^confirm',[['confirm']]],['^input',[['__set_model',['','isShow','$event',[]]]]]]}}" bind:confirm="__e" bind:input="__e" bind:__l="__l"></u-select></view>